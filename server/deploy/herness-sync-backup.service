[Unit]
Description=Private Herness PostgreSQL backup
After=postgresql-16.service herness-sync-cleanup.service

[Service]
Type=oneshot
User=herness-sync
Group=herness-sync
WorkingDirectory=/opt/herness-sync/current
EnvironmentFile=/etc/herness-sync/server.env
ExecStart=/opt/herness-sync/venv/bin/python -m herness_sync.backup
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/herness-sync/backups
UMask=0077
