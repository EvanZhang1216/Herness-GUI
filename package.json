{
  "name": "herness-gui-workspace",
  "version": "1.0.0",
  "description": "Standalone Windows distribution of Hermes Agent",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspace apps/desktop",
    "package": "npm run builder --workspace apps/desktop -- --win nsis --x64 --publish never",
    "test:focused": "npm exec --workspace apps/desktop -- vitest run src/app/shell/model-reasoning-persistence.test.tsx src/store/model-presets.test.ts src/components/assistant-ui/thread/processing-details.test.tsx src/app/settings/model-settings.test.tsx src/app/settings/endpoint-presets.test.ts src/app/contrib/session-rpc-dispatcher.test.ts electron/distribution-updates.test.ts scripts/storage-core.test.mjs scripts/account-core.test.mjs src/app/session/hooks/use-model-controls.test.tsx",
    "test:packaged": "npm exec --workspace apps/desktop -- tsx scripts/verify-personal.ts",
    "upstream:check": "node scripts/check-upstream.mjs",
    "test:unified-models": "npm exec --workspace apps/desktop -- tsx scripts/verify-unified-models.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EvanZhang1216/Herness-GUI.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/EvanZhang1216/Herness-GUI/issues"
  },
  "homepage": "https://github.com/EvanZhang1216/Herness-GUI",
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "typescript-eslint": "8.64.0",
    "eslint-plugin-perfectionist": "5.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.7.0"
  },
  "overrides": {
    "lodash": "4.18.1",
    "yauzl": "^3.3.1",
    "protobufjs": "^8.7.1",
    "brace-expansion": "5.0.9",
    "mermaid": "11.16.1",
    "dompurify": "3.4.13",
    "ip-address": "10.3.1",
    "nanoid@^3": "3.3.18",
    "nanoid@^6": "6.0.0",
    "js-yaml@^4": "4.3.1",
    "undici@^6": "6.28.0",
    "undici@^7": "7.29.0",
    "postcss": "8.5.23",
    "tar": "7.5.22"
  },
  "engines": {
    "node": "^22.22.0 || ^24.11.0 || >=26.0.0",
    "npm": "<11.10.0 || >=11.17.0"
  },
  "allowScripts": {
    "unicode-animations": false,
    "esbuild@0.28.1": true,
    "node-pty@1.1.0": true,
    "electron-winstaller@5.4.0": true,
    "electron@40.10.2": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true,
    "get-windows@9.3.0": true
  }
}
